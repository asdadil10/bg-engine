[AI]
apiKey=
endpoint=https://openrouter.ai/api/v1/chat/completions
llamaPath=
maxTokens=2048
model=openai/gpt-4o
systemPrompt=You are a helpful AI assistant.
temperature=0.7

[Effects]
circuit=false
hologram=false
vignette=false

[Layout]
leftBookmarkHeight=0.35
leftSensorHeight=0.55
leftWidth=350
panelsLayoutJson="{\"mainTerminal\":{\"x\":592,\"y\":96,\"width\":768,\"height\":1072}}"
rightControlsHeight=180
rightNetworkHeight=220
rightNotesHeight=0.45
rightWidth=350

[Notes]
text=// NEURAL LINK LOGS //\n[SECURE RECORD] Enter custom logs here...

[Panels]
editMode=false
showLeftBookmarkBar=true
showLeftMediaPanel=true
showLeftSensorPanel=true
showMainTerminal=true
showRightAIPanel=false
showRightControlsPanel=true
showRightNetworkPanel=true
showRightNotesPanel=true

[Presets]
customPresetsJson=[]
fetchedModelsJson=[]

[Shortcuts]
iconPadding=16
iconSize=16
shortcutsJson=[]

[Style]
fontFamily=monospace
fontScale=0.8
panelStyle=0

[Theme]
accentColor=#00f0ff
bgColor=#08090d
bgImage=
bgImageOpacity=0.15
gridOpacity=0
highlightColor=#ff007f
hudOpacity=0.1
