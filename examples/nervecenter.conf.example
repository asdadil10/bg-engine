# NerveCenter — local settings example
#
# NerveCenter keeps panel-local UI state in this file through QtCore's
# `Settings` component (~/.config/kde.org/plasmashell.conf).
#
# Base style and micro-effects are NOT stored here. They live in KConfig
# under [Containments][N][Wallpaper][org.kde.nervecenter][General], so they
# are per containment, survive a local-settings reset, and are the single
# source of truth after the one-time migration.
#
# This file is shared with other plasmashell components, so only add the
# groups you actually need. Edit it while plasmashell is stopped.

[Layout]
leftWidth=350
rightWidth=350
leftSensorHeight=0.55
leftBookmarkHeight=0.35
rightNotesHeight=0.45
rightNetworkHeight=220
rightControlsHeight=180
panelsLayoutJson="{}"
editMode=false
themeBgColor=
themeAccentColor=
themeHighlightColor=
gridOpacity=-1
bgImageOpacity=-1
hudOpacity=-1
bgImageOverride=
fontFamilyOverride=
fontScaleOverride=-1

[PanelsVisibility]
hasSavedState=false
showMainTerminal=true
showLeftMediaPanel=true
showLeftSensorPanel=true
showLeftBookmarkBar=true
showRightNotesPanel=true
showRightNetworkPanel=true
showRightControlsPanel=true
showTodoPanel=false
showGitGridPanel=false

[DeckWeather]
cachedJson=

[MediaPanel]
showVisualizer=false

[Notes]
text=

[Directives]
tasksJson=[]

[Launchpad]
selectedIconPack=

[GitGrid]
repoPath=
customRepoPath=
username=
cachedJson=
cachedTotal=0

[QuoteOfDay]
quoteIndex=0
lastDate=
